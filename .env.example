# Copy this file to .env and fill in the values from your EmailJS dashboard.
# Leave them empty to run the form in demo mode (shows success, sends nothing).
#
# Lead recipients are set in the EmailJS template's "To Email" field, not here.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_LEAD_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
